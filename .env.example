# Required
BOT_TOKEN=your_bot_token
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/leadfunnel
ADMIN_ID=123456789

# Optional: rate limiting (messages per period per user)
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_PERIOD=2

# Optional: delay between broadcast messages (seconds)
BROADCAST_DELAY=0.05
